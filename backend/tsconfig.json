{
    "compilerOptions": {
        "target": "ES2020",
        "moduleResolution": "node16",
        "rootDir": ".",
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true,
        "types": [
            "node"
        ],
        "resolveJsonModule": true,
        "module": "NodeNext",
        "skipLibCheck": true
    },
    "include": [
        "**/*.ts"
    ],
    "exclude": [
        "node_modules",
        "dist"
    ]
}